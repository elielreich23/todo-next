# Django Settings
DJANGO_SETTINGS_MODULE=taskero_backend.settings_production
SECRET_KEY=your-super-secret-key-here-generate-a-new-one-change-in-production
DEBUG=False

# Database
# For Render: This will be automatically set from the linked database service
# For local: Use postgresql://user:password@host:port/database
# For local development: sqlite:///db.sqlite3
DATABASE_URL=postgresql://user:password@host:port/database

# Security - ALLOWED_HOSTS
# For Render: taskero-backend.onrender.com will be auto-detected, but you can add more
# Add your custom domain here if you have one (comma-separated)
# Example: ALLOWED_HOSTS=taskero-backend.onrender.com,yourdomain.com,localhost,127.0.0.1
ALLOWED_HOSTS=taskero-backend.onrender.com,localhost,127.0.0.1

# Security Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# CORS - IMPORTANT: Add your Vercel frontend URL here
# Replace 'your-vercel-app' with your actual Vercel app name
# For Vercel preview deployments, you may need to add multiple URLs
# Example: CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:3000

# Optional: For local development, uncomment these:
# DEBUG=True
# DATABASE_URL=sqlite:///db.sqlite3
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# CORS_ALLOWED_ORIGINS=http://localhost:3000
