# Django Settings
DJANGO_SETTINGS_MODULE=taskero_backend.settings_production
SECRET_KEY=your-super-secret-key-here-generate-a-new-one-change-in-production
DEBUG=False

# Database
# For Render/Railway: This will be automatically set from the linked database service
# For local: Use postgresql://user:password@host:port/database
# For local development: sqlite:///db.sqlite3
DATABASE_URL=postgresql://user:password@host:port/database

# Security - ALLOWED_HOSTS
# For Render: taskero-backend.onrender.com will be auto-detected
# For Railway: your-app.up.railway.app will be auto-detected
# Add your custom domain here if you have one (comma-separated)
# Example: ALLOWED_HOSTS=your-app.up.railway.app,yourdomain.com,localhost,127.0.0.1
ALLOWED_HOSTS=your-app.up.railway.app,localhost,127.0.0.1

# Security Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# CORS - IMPORTANT: Add your Vercel frontend URL here
# Replace 'your-vercel-app' with your actual Vercel app name
# For Vercel preview deployments, you may need to add multiple URLs
# Example: CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app,http://localhost:3000
# For Railway + Vercel setup, use your Vercel production and preview URLs
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:3000

# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email Configuration (for password reset)
# With Gmail credentials present, SMTP is selected automatically.
# Without credentials, emails are printed to the Django console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
FRONTEND_URL=http://localhost:3000
# Optional local-only shortcut. Leave False for real email reset links.
PASSWORD_RESET_DEBUG_TOKENS=False

# Optional: For local development, uncomment these:
# DEBUG=True
# DATABASE_URL=sqlite:///db.sqlite3
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# CORS_ALLOWED_ORIGINS=http://localhost:3000
